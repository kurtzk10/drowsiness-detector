<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ adaptive icon. The launcher masks this to its own shape
     (circle, squircle, teardrop), so the foreground keeps the logo inside the
     central safe zone instead of filling the canvas — at full bleed the mask
     would slice off the "DETECTION SYSTEM" line. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
