# Root-level files stay local; subfolders are tracked as normal.
# Kept first so the folder-specific rules below (.idea/, logs/, ...) still win.
/*
!/*/
!/.gitignore
!/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Session logs (research data — archive separately, not in git)
logs/

# Node
package.json
package-lock.json

# Old models
models/old/

# Android build outputs (Gradle regenerates these; committing them churns
# hundreds of files on every build)
drowsiness_detector/android/**/build/
drowsiness_detector/android/**/.gradle/

# Machine-specific SDK path — the file's own header says not to commit it
drowsiness_detector/android/**/local.properties

# Generated by tools/list_cameras.py
tools/camera_previews/

# Markdown notes stay local; only READMEs are committed
*.md
!README.md
